  {
    "id": 6,
    "priority": 2,
    "action": { "type": "redirect", "redirect": { "extensionPath": "/surrogates/gtag.js" } },
    "condition": {
      "domainType": "thirdParty",
      "urlFilter": "||googletagmanager.com/gtag/js",
