  {
    "id": 2,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "domainType": "thirdParty",
      "urlFilter": "||connect.facebook.net^*/fbevents.js",
      "resourceTypes": ["script"]
    }
  },
  {
    "id": 3,
    "priority": 1,
    "action": { "type": "block" },
    "condition": {
      "domainType": "thirdParty",
      "urlFilter": "||facebook.com/tr",
      "resourceTypes": ["image", "ping", "xmlhttprequest", "other"]
    }
  },
  {
    "id": 4,
    "priority": 1,
    "action": { "type": "block" },
    "condition": { "domainType": "thirdParty", "resourceTypes": ["ping"] }
  },
  {
    "id": 5,
    "priority": 2,
    "action": { "type": "redirect", "redirect": { "extensionPath": "/surrogates/ga.js" } },
    "condition": {
      "domainType": "thirdParty",
      "urlFilter": "||google-analytics.com/analytics.js",
