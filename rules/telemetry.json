        "nr-data.net", "js-agent.newrelic.com", "browser-intake-datadoghq.com", "browser-intake-datadoghq.eu",
        "scorecardresearch.com", "quantserve.com", "chartbeat.com", "chartbeat.net",
        "bat.bing.com", "analytics.tiktok.com", "px.ads.linkedin.com", "snap.licdn.com",
