{
  "manifest_version": 3,
  "name": "AndItsGone",
  "version": "1.3.1",
  "description": "AI Overviews, cookie banners, popups, autoplay, trackers... and it's gone. The web, the way you remember it.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "build/background.js",
    "scripts": [
      "build/background.js"
    ]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "reddit",
        "enabled": true,
        "path": "rules/reddit.json"
      },
      {
        "id": "gpc",
        "enabled": true,
        "path": "rules/gpc.json"
      },
      {
        "id": "telemetry",
        "enabled": true,
        "path": "rules/telemetry.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/frame.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/defaults.js",
        "content/google.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "build/consent.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "AndItsGone",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anditsgone@local.extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "surrogates/ga.js",
        "surrogates/gtag.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
